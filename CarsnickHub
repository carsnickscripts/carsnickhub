local function ReactivateOnRespawn(char)
    if not char then return end
    char:WaitForChild("HumanoidRootPart")
    task.wait(0.2)

    local lp = game:GetService("Players").LocalPlayer
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if _G.LastWalkSpeed and _G.LastWalkSpeed > 16 then
        hum.WalkSpeed = _G.LastWalkSpeed
    end

    if _G.LastJumpPower and _G.LastJumpPower > 50 then
        hum.UseJumpPower = true
        hum.JumpPower = _G.LastJumpPower
    end

    if _G.SpeedMultiplierEnabled then
        if _G.SpeedMultiplierConnection then
            _G.SpeedMultiplierConnection:Disconnect()
            _G.SpeedMultiplierConnection = nil
        end

        _G.SpeedMultiplierConnection = RunService.Heartbeat:Connect(function(deltaTime)
            if not _G.SpeedMultiplierEnabled then return end
            local character = lp.Character
            if not character then return end
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if not (rootPart and humanoid) then return end

            if _G.WeepingAngelEnabled and humanoid.WalkSpeed == 0 then return end

            if humanoid.MoveDirection.Magnitude > 0.05 then
                local raw = _G.SpeedMultiplierValue or 60
                local multiplier = raw / 10
                local speed = multiplier * 16
                local moveVector = humanoid.MoveDirection * speed * deltaTime
                rootPart.CFrame = rootPart.CFrame + moveVector
            end
        end)
    end

    if _G.InfJump then
        game:GetService("UserInputService").JumpRequest:Connect(function()
            if _G.InfJump and lp.Character then
                local h = lp.Character:FindFirstChildOfClass("Humanoid")
                if h then h:ChangeState("Jumping") end
            end
        end)
    end

    if _G.AntiFling then
        task.spawn(function()
            while _G.AntiFling and lp.Character do
                for _, player in pairs(game:GetService("Players"):GetPlayers()) do
                    if player ~= lp and player.Character then
                        for _, part in pairs(player.Character:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                                part.Velocity = Vector3.new(0, 0, 0)
                                part.RotVelocity = Vector3.new(0, 0, 0)
                            end
                        end
                    end
                end
                task.wait()
            end
        end)
    end

    if _G.Godmode then
        if _G.GodmodeConnection then
            _G.GodmodeConnection:Disconnect()
            _G.GodmodeConnection = nil
        end

        _G.GodmodeConnection = RunService.Heartbeat:Connect(function()
            pcall(function()
                local c = lp.Character
                if c then
                    local h = c:FindFirstChildOfClass("Humanoid")
                    if h then
                        h.MaxHealth = math.huge
                        h.Health = h.MaxHealth
                        h:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                    end
                    if not c:FindFirstChild("CarsnickGodFF") then
                        local ff = Instance.new("ForceField")
                        ff.Name = "CarsnickGodFF"
                        ff.Visible = false
                        ff.Parent = c
                    end
                end
            end)
        end)
    end

    if _G.Flying then
        task.spawn(function()
            local root = char:WaitForChild("HumanoidRootPart")
            local camera = workspace.CurrentCamera
            local h = char:FindFirstChildOfClass("Humanoid")

            if root:FindFirstChild("FlyGyro") then root.FlyGyro:Destroy() end
            if root:FindFirstChild("FlyVelocity") then root.FlyVelocity:Destroy() end

            local bg = Instance.new("BodyGyro", root)
            bg.Name = "FlyGyro"
            bg.P = 9e4
            bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)

            local bv = Instance.new("BodyVelocity", root)
            bv.Name = "FlyVelocity"
            bv.maxForce = Vector3.new(9e9, 9e9, 9e9)

            while _G.Flying and char and char.Parent do
                task.wait()
                if h then h.PlatformStand = true end
                local currentSpeed = _G.FlySpeed or 60
                local moveDir = h and h.MoveDirection or Vector3.new()

                if moveDir.Magnitude > 0 then
                    local relativeDir = camera.CFrame:VectorToObjectSpace(moveDir)
                    local direction = (camera.CFrame.LookVector * -relativeDir.Z) + (camera.CFrame.RightVector * relativeDir.X)
                    bv.velocity = direction.Unit * currentSpeed
                else
                    bv.velocity = Vector3.new(0, 0, 0)
                end
                bg.cframe = camera.CFrame
            end

            if h then h.PlatformStand = false end
            if bg then bg:Destroy() end
            if bv then bv:Destroy() end
        end)
    end

    if _G.Noclip then
        task.spawn(function()
            while _G.Noclip and char and char.Parent do
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
                task.wait()
            end
        end)
    end

    print("[CarsnickHub] Respawn detected — features re-activated")
end

