         sg.IgnoreGuiInset = true
         sg.Parent = coreGui

         local txt = Instance.new("TextLabel")
         txt.Size = UDim2.new(1, 0, 1, 0)
         txt.Position = UDim2.new(0, 0, 0, 0)
         txt.BackgroundTransparency = 1
         txt.Text = textLabel or "Loading..."
         txt.TextScaled = true
         txt.Font = Enum.Font.GothamBlack
         txt.TextStrokeTransparency = 0
         txt.TextStrokeColor3 = Color3.new(0, 0, 0)
         txt.Parent = sg

         local constraint = Instance.new("UITextSizeConstraint")
         constraint.MaxTextSize = 65
         constraint.Parent = txt

         task.spawn(function()
            local hue = 0
            while sg.Parent do
               hue = hue + 0.005
               if hue > 1 then hue = 0 end
               txt.TextColor3 = Color3.fromHSV(hue, 1, 1)
               RunService.RenderStepped:Wait()
            end
         end)
      end

      _G.PotatoModeEnabled = Value
      potatoSession = potatoSession + 1
      local currentSession = potatoSession

      if Value then
         ToggleLoadingScreen(true, "Loading Potato Graphics...")

         if originalLighting["GlobalShadows"] == nil then
            originalLighting["GlobalShadows"] = game:GetService("Lighting").GlobalShadows
         end
         game:GetService("Lighting").GlobalShadows = false

         for _, effect in ipairs(game:GetService("Lighting"):GetChildren()) do
            if effect:IsA("PostEffect") or effect:IsA("Atmosphere") or effect:IsA("Clouds") then
               if originalLighting[effect] == nil then
                  originalLighting[effect] = effect.Enabled
               end
               effect.Enabled = false
            end
         end

         local terrain = workspace:FindFirstChildOfClass("Terrain")
         if terrain then
            if originalTerrain["WaterWaveSize"] == nil then
               originalTerrain["WaterWaveSize"] = terrain.WaterWaveSize
               originalTerrain["WaterWaveSpeed"] = terrain.WaterWaveSpeed
               originalTerrain["WaterReflectance"] = terrain.WaterReflectance
               originalTerrain["WaterTransparency"] = terrain.WaterTransparency
            end
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 0
         end

         task.spawn(function()
            local descendants = workspace:GetDescendants()
            for i, object in ipairs(descendants) do
               if currentSession ~= potatoSession or not _G.PotatoModeEnabled then break end

               if object:IsA("BasePart") and not object:IsAncestorOf(LocalPlayer.Character) then
                  if not originalProperties[object] then
                     originalProperties[object] = {
                        Material = object.Material,
                        CastShadow = object.CastShadow
                     }
                  end
                  object.Material = Enum.Material.SmoothPlastic
                  object.CastShadow = false
               elseif object:IsA("Decal") or object:IsA("Texture") then
                  if not originalProperties[object] then
                     originalProperties[object] = { Transparency = object.Transparency }
                  end
                  object.Transparency = 1
               elseif object:IsA("ParticleEmitter") or object:IsA("Trail") then
                  if not originalProperties[object] then
                     originalProperties[object] = { Enabled = object.Enabled }
                  end
                  object.Enabled = false
               end

               if i % 150 == 0 then task.wait() end
            end

            if currentSession == potatoSession then
               ToggleLoadingScreen(false)
            end
         end)

         if _G.PotatoBackgroundConn then _G.PotatoBackgroundConn:Disconnect() end
         _G.PotatoBackgroundConn = workspace.DescendantAdded:Connect(function(object)
            if _G.PotatoModeEnabled then
               task.wait(0.1)
               if object:IsA("BasePart") and not object:IsAncestorOf(LocalPlayer.Character) then
                  object.Material = Enum.Material.SmoothPlastic
                  object.CastShadow = false
               elseif object:IsA("Decal") or object:IsA("Texture") then
                  object.Transparency = 1
               elseif object:IsA("ParticleEmitter") or object:IsA("Trail") then
                  object.Enabled = false
               end
            end
         end)

      else
         ToggleLoadingScreen(true, "Restoring High Graphics...")

         if _G.PotatoBackgroundConn then
            _G.PotatoBackgroundConn:Disconnect()
            _G.PotatoBackgroundConn = nil
         end

         if originalLighting["GlobalShadows"] ~= nil then
            game:GetService("Lighting").GlobalShadows = originalLighting["GlobalShadows"]
         end
         for effect, state in pairs(originalLighting) do
            if typeof(effect) == "Instance" and effect.Parent then
               effect.Enabled = state
            end
         end

         local terrain = workspace:FindFirstChildOfClass("Terrain")
         if terrain and originalTerrain["WaterWaveSize"] ~= nil then
            terrain.WaterWaveSize = originalTerrain["WaterWaveSize"]
            terrain.WaterWaveSpeed = originalTerrain["WaterWaveSpeed"]
            terrain.WaterReflectance = originalTerrain["WaterReflectance"]
            terrain.WaterTransparency = originalTerrain["WaterTransparency"]
         end

         task.spawn(function()
            local descendants = workspace:GetDescendants()
            for i, object in ipairs(descendants) do
               if currentSession ~= potatoSession or _G.PotatoModeEnabled then break end

               local orig = originalProperties[object]
               if orig then
                  if object:IsA("BasePart") then
                     object.Material = orig.Material
                     object.CastShadow = orig.CastShadow
                  elseif object:IsA("Decal") or object:IsA("Texture") then
                     object.Transparency = orig.Transparency
                  elseif object:IsA("ParticleEmitter") or object:IsA("Trail") then
                     object.Enabled = orig.Enabled
                  end
               end

               if i % 150 == 0 then task.wait() end
            end

            if currentSession == potatoSession then
               ToggleLoadingScreen(false)
            end
         end)
      end
   end,
})

local InstantAimbotToggle = CombatTab:CreateToggle({
    Name = "Aimbot🔫",
    CurrentValue = false,
    Flag = "InstantAimbotToggle",
    Callback = function(Value)
        aimbotEnabled = Value
        if Value then
            if aimbotConnection then 
                aimbotConnection:Disconnect() 
            end
            
            aimbotConnection = game:GetService("RunService").RenderStepped:Connect(function()
                if not aimbotEnabled then return end
                
                local camera = workspace.CurrentCamera
                local myChar = game.Players.LocalPlayer.Character
                if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
                
                if showFOVCircle then
                    local center = camera.ViewportSize / 2
                    fovCircle.Position = center
                    fovCircle.Radius = aimbotFOV * 2.8
                end
                
                local closest = nil
                local shortestDist = aimbotFOV
                
                for _, player in ipairs(game.Players:GetPlayers()) do
                    if player == game.Players.LocalPlayer then continue end
                    
                    if teamCheckEnabled and player.Team == game.Players.LocalPlayer.Team then
                        continue
                    end
                    
                    local char = player.Character
                    
                    if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then 
                        continue 
                    end
                    
                    if not char:FindFirstChild(aimPart) then continue end
                    
                    local targetPart = char[aimPart]
                    local targetPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                    
                    if onScreen then
                        local mousePos = camera.ViewportSize / 2
                        local dist = (Vector2.new(targetPos.X, targetPos.Y) - mousePos).Magnitude
                        
                        local rayParams = RaycastParams.new()
                        rayParams.FilterDescendantsInstances = {myChar}
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        local rayResult = workspace:Raycast(myChar.HumanoidRootPart.Position, (targetPart.Position - myChar.HumanoidRootPart.Position).Unit * 1000, rayParams)
                        
                        local visible = not rayResult or rayResult.Instance:IsDescendantOf(char)
                        
                        if dist < shortestDist and visible then
                            shortestDist = dist
                            closest = targetPart
                        end
                    end
                end
                
                if closest then
                    if smoothness <= 0.06 then
                        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, closest.Position)
                    else
                        local currentCFrame = camera.CFrame
                        local targetCFrame = CFrame.lookAt(currentCFrame.Position, closest.Position)
                        camera.CFrame = currentCFrame:Lerp(targetCFrame, smoothness)
                    end
                end
            end)
        else
            if aimbotConnection then
                aimbotConnection:Disconnect()
                aimbotConnection = nil
            end
        end
    end,
})

