local WEToggle = CoolTab:CreateToggle({
   Name = "Weeping Angel Mode 👁️",
   CurrentValue = false,
   Flag = "WeepingAngelMain", 
   Callback = function(Value)
      _G.WeepingAngelEnabled = Value
      local LocalPlayer = game:GetService("Players").LocalPlayer
      
      if Value then
         if _G.WeepingAngelConnection then 
            _G.WeepingAngelConnection:Disconnect() 
         end
         
         local lastTwitchTime = os.clock()
         
         _G.WeepingAngelConnection = game:GetService("RunService").RenderStepped:Connect(function()
            if not _G.WeepingAngelEnabled then return end
            
            local myCharacter = LocalPlayer.Character
            local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
            local myHumanoid = myCharacter and myCharacter:FindFirstChildOfClass("Humanoid")
            
            if not myRoot or not myHumanoid or _G.IsJumpscaring then return end

            local isBeingWatched = false
            
            local targetList = _G.SelectedTargetPlayers or {"All Players"}
            local targetEveryone = table.find(targetList, "All Players") ~= nil

            for _, player in ipairs(game.Players:GetPlayers()) do
               if player ~= LocalPlayer and player.Character then
                  
                  if not targetEveryone and not table.find(targetList, player.Name) then
                     continue
                  end
                  
                  local enemyRoot = player.Character:FindFirstChild("HumanoidRootPart")
                  local enemyHead = player.Character:FindFirstChild("Head")
                  local enemyHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
                  
                  if enemyRoot and enemyHead and enemyHumanoid and enemyHumanoid.Health > 0 then
                     local distance = (myRoot.Position - enemyRoot.Position).Magnitude
                     
                     if _G.JumpscareOnTouch and distance <= 3.5 then
                        _G.IsJumpscaring = true
                        task.spawn(function()
                           local camera = workspace.CurrentCamera
                           local originalWalkSpeed = myHumanoid.WalkSpeed
                           myHumanoid.WalkSpeed = 0
                           
                           local scream = Instance.new("Sound", myRoot)
                           scream.SoundId = "rbxassetid://9069609268"
                           scream.Volume = 3
                           scream:Play()
                           
                           local startTime = os.clock()
                           while os.clock() - startTime < 1.5 do
                              task.wait()
                              if not enemyRoot or not myRoot then break end
                              local timeFactor = os.clock() * 75
                              local targetCFrame = enemyRoot.CFrame * CFrame.new(math.sin(timeFactor) * 0.5, math.cos(timeFactor * 1.5) * 0.5, -(2.0 + (math.sin(os.clock() * 40) * 0.7)))
                              myRoot.CFrame = CFrame.lookAt(targetCFrame.Position, enemyRoot.Position)
                              camera.CFrame = camera.CFrame * CFrame.Angles(math.random(-6, 6)/100, math.random(-6, 6)/100, math.random(-6, 6)/100)
                           end
                           
                           if myRoot and enemyRoot then
                              myRoot.CFrame = enemyRoot.CFrame * CFrame.new(0, 0, 15)
                           end
                           scream:Destroy()
                           if myHumanoid then myHumanoid.WalkSpeed = originalWalkSpeed end
                           task.wait(0.7)
                           _G.IsJumpscaring = false
                        end)
                        break
                     end

                     if distance <= _G.AngelMaxDistance then
                        local directionToMe = (myRoot.Position - enemyHead.Position).Unit
                        local enemyLookDirection = enemyHead.CFrame.LookVector
                        
                        local dotProduct = enemyLookDirection:Dot(directionToMe)
                        local angleDegrees = math.deg(math.acos(math.clamp(dotProduct, -1, 1)))
                        
                        if angleDegrees <= (_G.AngelDetectionFOV / 2) then
                           local rayParams = RaycastParams.new()
                           local ignoreList = {}
                           for _, p in ipairs(game.Players:GetPlayers()) do
                              if p ~= LocalPlayer and p.Character then table.insert(ignoreList, p.Character) end
                           end
                           rayParams.FilterDescendantsInstances = ignoreList
                           rayParams.FilterType = Enum.RaycastFilterType.Exclude
                           
                           local rayResult = workspace:Raycast(enemyHead.Position, (myRoot.Position - enemyHead.Position), rayParams)
                           if not rayResult or rayResult.Instance:IsDescendantOf(myCharacter) then
                              isBeingWatched = true
                              break 
                           end
                        end
                     end
                  end
               end
            end

            if isBeingWatched then
               myHumanoid.WalkSpeed = 0
               if os.clock() - lastTwitchTime >= 5 then
                  lastTwitchTime = os.clock()
                  task.spawn(function()
                     local originalCFrame = myRoot.CFrame
                     for i = 1, 4 do
                        myRoot.CFrame = originalCFrame * CFrame.new(math.random(-10, 10)/20, 0, math.random(-10, 10)/20) * CFrame.Angles(0, math.rad(math.random(-15, 15)), 0)
                        task.wait(0.02)
                     end
                     myRoot.CFrame = originalCFrame
                  end)
               end
            else
               myHumanoid.WalkSpeed = 16 
               lastTwitchTime = os.clock()
            end
         end)
      else
         if _G.WeepingAngelConnection then
            _G.WeepingAngelConnection:Disconnect()
            _G.WeepingAngelConnection = nil
         end
         pcall(function()
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid then humanoid.WalkSpeed = 16 end
         end)
      end
   end,
})

