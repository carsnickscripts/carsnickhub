    edge.Parent = cubeContainer
    edge.BorderSizePixel = 0
    edge.AnchorPoint = Vector2.new(0.5, 0.5)
    edge.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    table.insert(edgeFrames, edge)
end

local size = 22
local vertices = {
    Vector3.new(-size, -size, -size), Vector3.new(size, -size, -size),
    Vector3.new(size, size, -size), Vector3.new(-size, size, -size),
    Vector3.new(-size, -size, size), Vector3.new(size, -size, size),
    Vector3.new(size, size, size), Vector3.new(-size, size, size)
}
local edges = {
    {1,2},{2,3},{3,4},{4,1}, {5,6},{6,7},{7,8},{8,5}, {1,5},{2,6},{3,7},{4,8}
}

local rotX, rotY, rotZ = 0, 0, 0
RunService.RenderStepped:Connect(function(dt)
    local hue = (tick() * 0.2) % 1
    toggleStroke.Color = Color3.fromHSV(hue, 1, 1)

    rotX = rotX + dt * 1.2
    rotY = rotY + dt * 1.5
    rotZ = rotZ + dt * 0.8
    
    local rotatedVertices = {}
    for i, v in ipairs(vertices) do
        local y1 = v.Y * math.cos(rotX) - v.Z * math.sin(rotX)
        local z1 = v.Y * math.sin(rotX) + v.Z * math.cos(rotX)
        local x1 = v.X
        local x2 = x1 * math.cos(rotY) + z1 * math.sin(rotY)
        local z2 = -x1 * math.sin(rotY) + z1 * math.cos(rotY)
        local y2 = y1
        local x3 = x2 * math.cos(rotZ) - y2 * math.sin(rotZ)
        local y3 = x2 * math.sin(rotZ) + y2 * math.cos(rotZ)
        local z3 = z2

        local perspective = 200 / (200 + z3)
        rotatedVertices[i] = Vector2.new(x3 * perspective + 30, y3 * perspective + 30)
    end

    for i, edge in ipairs(edges) do
        local p1 = rotatedVertices[edge[1]]
        local p2 = rotatedVertices[edge[2]]
        local center = (p1 + p2) / 2
        local length = (p2 - p1).Magnitude
        local angle = math.atan2(p2.Y - p1.Y, p2.X - p1.X)

        local edgeFrame = edgeFrames[i]
        edgeFrame.Size = UDim2.new(0, length, 0, 2)
        edgeFrame.Position = UDim2.new(0, center.X, 0, center.Y)
        edgeFrame.Rotation = math.deg(angle)
        edgeFrame.BackgroundColor3 = Color3.fromHSV((hue + (i * 0.05)) % 1, 1, 1)
    end
end)

