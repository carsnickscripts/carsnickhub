local function autoRefreshPlayerList()
   local currentPlayers = game:GetService("Players"):GetPlayers()
   local localPlayer = game:GetService("Players").LocalPlayer
   
   local playerNames = {}
   
   for _, player in ipairs(currentPlayers) do
      if player ~= localPlayer then
         table.insert(playerNames, player.Name)
      end
   end
   
   table.sort(playerNames, function(a, b)
      return a:lower() < b:lower()
   end)
   
   local newList = {"All Players"}
   for _, name in ipairs(playerNames) do
      table.insert(newList, name)
   end
   
   CoolDropdown:Refresh(newList)
end

game:GetService("Players").PlayerAdded:Connect(autoRefreshPlayerList)
